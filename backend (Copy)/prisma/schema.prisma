datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("USER")
  createdAt    DateTime @default(now())

  totpSecret   String?
  totpEnabled  Boolean  @default(false)

  resume       Resume?


  applications Application[]
  messages     Message[]
  conversations ConversationParticipant[]
  userKeys     UserKey[]
  otpLogs      OtpLog[]
  auditLogs    AuditLog[]
}

model Resume {
  id                String @id @default(cuid())
  userId            String @unique
  encryptedFilePath String
  iv                String
  originalName      String
  user              User   @relation(fields: [userId], references: [id])
}


enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  REJECTED
  ACCEPTED
}


model Company {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  jobs         Job[]
  
  // 1. ADDITIVE CHANGE: Allow Company to link to chats and messages
  participants ConversationParticipant[]
  messages     Message[]
}

model Job {
  id          String   @id @default(cuid())
  title       String
  description String
  createdAt   DateTime @default(now())

  // 2. SAFE CHANGE: New optional search/filter fields
  location    String?
  isRemote    Boolean  @default(false)
  jobType     String   @default("FULL_TIME") // e.g. FULL_TIME, INTERNSHIP
  tags        String?  // comma-separated e.g. "react,node,aws"

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])

  applications Application[]
}

model Application {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  status      ApplicationStatus @default(APPLIED)

  // 3. SAFE CHANGE: Added cover note
  coverNote   String?

  userId      String
  jobId       String

  user        User @relation(fields: [userId], references: [id])
  job         Job  @relation(fields: [jobId], references: [id])

  // 4. ADDITIVE: Link to new recruiter notes
  notes       RecruiterNote[]

  @@unique([userId, jobId])
}

model RecruiterNote {
  id            String   @id @default(cuid())
  note          String
  createdAt     DateTime @default(now())
  
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  authorId      String   // Company user ID who wrote the note
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  isGroup   Boolean  @default(false)

  participants ConversationParticipant[]
  messages     Message[]
}
model ConversationParticipant {
  id             String @id @default(cuid())
  
  // 2. SAFE CHANGE: Make userId optional, add optional companyId
  userId         String?
  companyId      String?
  
  conversationId String

  // 3. SAFE CHANGE: Update relations to match the optional fields
  user           User?         @relation(fields: [userId], references: [id])
  company        Company?      @relation(fields: [companyId], references: [id])
  conversation   Conversation  @relation(fields: [conversationId], references: [id])

  // NOTE: Removed @@unique([userId, conversationId]) to prevent SQLite null-constraint crashes
}

model Message {
  id             String   @id @default(cuid())
  encryptedText  String
  iv             String
  encryptedKey   String 

  createdAt      DateTime @default(now())

  // 4. SAFE CHANGE: Make senderId optional, add optional companyId
  senderId       String?
  companyId      String?
  
  conversationId String

  // 5. SAFE CHANGE: Update relations to match the optional fields
  sender         User?         @relation(fields: [senderId], references: [id])
  company        Company?      @relation(fields: [companyId], references: [id])
  conversation   Conversation  @relation(fields: [conversationId], references: [id])
}


model UserKey {
  id        String   @id @default(cuid())
  userId    String
  publicKey String   // PEM/Base64
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id])
  @@unique([userId, publicKey])
}

model OtpLog {
  id        String   @id @default(cuid())
  userId    String
  success   Boolean
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  userId      String?
  metadata    String
  createdAt   DateTime @default(now())

  // tamper-evident chain
  prevHash    String
  hash        String
  @@index([createdAt])

  user        User? @relation(fields: [userId], references: [id])
}


